#: inc/help.bas:6
msgid "%1 %2 (build %3) - documentation generator for FreeBASIC"
msgstr "%1 %2 (build %3) - documentatiegenerator voor FreeBASIC"

#: inc/help.bas:8
msgid "Usage:  %1 [options] <path> [path2 ...]"
msgstr "Gebruik:  %1 [opties] <pad> [pad2 ...]"

#: inc/help.bas:10
msgid "Paths may be folders or individual files."
msgstr "Paden mogen mappen of losse bestanden zijn."

#: inc/help.bas:12
msgid "Options:"
msgstr "Opties:"

#: inc/help.bas:13
msgid "  -o, --output <file>      write output to file (otherwise stdout)"
msgstr "  -o, --output <bestand>   schrijf uitvoer naar bestand (anders stdout)"

#: inc/help.bas:14
msgid "  -f, --format <fmt>       text | md | html | json | dot | mermaid | tree"
msgstr "  -f, --format <fmt>       text | md | html | json | dot | mermaid | tree"

#: inc/help.bas:15
msgid "                           (default text)"
msgstr "                           (standaard text)"

#: inc/help.bas:16
msgid "  -l, --lang <code|.po>    language of all texts (default en); loads"
msgstr "  -l, --lang <code|.po>    taal van alle teksten (standaard en); laadt"

#: inc/help.bas:17
msgid "                           lang/<code>.po next to the program, or the"
msgstr "                           lang/<code>.po naast het programma, of het"

#: inc/help.bas:18
msgid "                           given .po file. FBDOC_LANG sets the default."
msgstr "                           opgegeven .po-bestand. FBDOC_LANG zet de standaard."

#: inc/help.bas:19
msgid "  -n, --name <name>        project name in the report header"
msgstr "  -n, --name <naam>        projectnaam in de kop van het rapport"

#: inc/help.bas:20
msgid "  -e, --ext <list>         extensions, comma separated (default .bas,.bi)"
msgstr "  -e, --ext <lijst>        extensies, kommagescheiden (standaard .bas,.bi)"

#: inc/help.bas:21
msgid "  -x, --exclude <pattern>  exclude path pattern (may be repeated)"
msgstr "  -x, --exclude <patroon>  pad-patroon uitsluiten (meerdere keren toegestaan)"

#: inc/help.bas:22
msgid "  -p, --private            include private functions (default on)"
msgstr "  -p, --private            private functies meenemen (standaard aan)"

#: inc/help.bas:23
msgid "      --no-private         document public functions only"
msgstr "      --no-private         alleen publieke functies documenteren"

#: inc/help.bas:24
msgid "  -R, --no-recursive       do not scan recursively"
msgstr "  -R, --no-recursive       niet recursief scannen"

#: inc/help.bas:25
msgid "  -G, --no-generate        do not generate descriptions for missing"
msgstr "  -G, --no-generate        geen beschrijvingen genereren bij ontbrekend"

#: inc/help.bas:26
msgid "                           comments (leave empty)"
msgstr "                           commentaar (laat leeg)"

#: inc/help.bas:27
msgid "  -u, --undocumented       show only elements without comments"
msgstr "  -u, --undocumented       toon alleen elementen zonder commentaar"

#: inc/help.bas:28
msgid "  -c, --coverage           print a coverage summary"
msgstr "  -c, --coverage           print dekkingsoverzicht"

#: inc/help.bas:29
msgid "      --fail-under <pct>   exit code 1 if coverage is below pct (CI)"
msgstr "      --fail-under <pct>   exitcode 1 als dekking onder pct ligt (CI)"

#: inc/help.bas:30
msgid "  -q, --quiet              no progress messages"
msgstr "  -q, --quiet              geen voortgangsmeldingen"

#: inc/help.bas:31
msgid "  -v, --verbose            messages per file"
msgstr "  -v, --verbose            per bestand meldingen"

#: inc/help.bas:32
msgid "  -d, --debug              show what Dir() returns per folder/file"
msgstr "  -d, --debug              toon wat Dir() teruggeeft per map/bestand"

#: inc/help.bas:33
msgid "      --log <file>         also write all messages to this file"
msgstr "      --log <bestand>      schrijf alle meldingen ook naar dit bestand"

#: inc/help.bas:35
msgid "Call graph (formats dot, mermaid, tree):"
msgstr "Aanroepgraaf (formaten dot, mermaid, tree):"

#: inc/help.bas:36
msgid "      --follow             follow #include references and read those"
msgstr "      --follow             #include verwijzingen volgen en die bestanden"

#: inc/help.bas:37
msgid "                           files as reference"
msgstr "                           als referentie meelezen"

#: inc/help.bas:38
msgid "  -i, --include <folder>   search path for #include (may be repeated)"
msgstr "  -i, --include <map>      zoekpad voor #include (mag meerdere keren)"

#: inc/help.bas:39
msgid "      --follow-depth <n>   how deep to follow transitively (default 2)"
msgstr "      --follow-depth <n>   hoe diep transitief volgen (standaard 2)"

#: inc/help.bas:40
msgid "      --refs <path>        read an extra path to resolve calls into other"
msgstr "      --refs <pad>         extra pad meelezen om aanroepen naar andere"

#: inc/help.bas:41
msgid "                           projects; that code is not documented, only"
msgstr "                           projecten op te lossen; die code wordt niet"

#: inc/help.bas:42
msgid "                           used in the diagram"
msgstr "                           gedocumenteerd, alleen in het diagram gebruikt"

#: inc/help.bas:43
msgid "                           (may be repeated)"
msgstr "                           (mag meerdere keren)"

#: inc/help.bas:44
msgid "      --ref-depth <n>      how many steps of reference code in the diagram"
msgstr "      --ref-depth <n>      hoeveel stappen referentiecode in het diagram"

#: inc/help.bas:45
msgid "                           (default 1: only what your code calls"
msgstr "                           (standaard 1: alleen wat jouw code direct"

#: inc/help.bas:46
msgid "                           directly; 0 = none)"
msgstr "                           aanroept; 0 = geen)"

#: inc/help.bas:47
msgid "      --extern             also show unresolved calls"
msgstr "      --extern             ook onopgeloste aanroepen tonen"

#: inc/help.bas:48
msgid "      --depth <n>          maximum depth of the text tree (default 12)"
msgstr "      --depth <n>          maximale diepte van de tekstboom (standaard 12)"

#: inc/help.bas:49
msgid "  -h, --help               this help"
msgstr "  -h, --help               deze hulp"

#: inc/help.bas:50
msgid "      --version            version"
msgstr "      --version            versie"

#: inc/help.bas:52
msgid "Default exclusions: /.git/  /.svn/  /obj/"
msgstr "Standaard uitsluitingen: /.git/  /.svn/  /obj/"

#: inc/help.bas:54
msgid "Examples:"
msgstr "Voorbeelden:"

#: inc/help.bas:63
msgid "     and then:  dot -Tsvg calls.dot -o calls.svg"
msgstr "     en dan:  dot -Tsvg calls.dot -o calls.svg"

#: inc/layout.bas:217
msgid "No call relations recognised, so no diagram."
msgstr "Geen aanroeprelaties herkend, dus geen diagram."

#: inc/layout.bas:221
msgid "Diagram skipped: %1 nodes cannot be followed, even with zooming. Use -f dot for a Graphviz version or scan a smaller part."
msgstr "Diagram overgeslagen: %1 knopen is ook met zoomen niet meer te volgen. Gebruik -f dot voor een Graphviz-versie of scan een kleiner deel."

#: inc/layout.bas:236
msgid "Zoom in"
msgstr "Inzoomen"

#: inc/layout.bas:237
msgid "Zoom out"
msgstr "Uitzoomen"

#: inc/layout.bas:238
msgid "Fit everything"
msgstr "Alles passend maken"

#: inc/layout.bas:268 inc/out_text.bas:446
msgid "recursive"
msgstr "recursief"

#: inc/layout.bas:295
msgid "feedback"
msgstr "terugkoppeling"

#: inc/out_graph.bas:24 inc/out_graph.bas:134
msgid "Generated by %1 %2 on %3"
msgstr "Gegenereerd door %1 %2 op %3"

#: inc/out_graph.bas:25
msgid "Render:"
msgstr "Renderen:"

#: inc/out_graph.bas:45
msgid "reference"
msgstr "referentie"

#: inc/out_graph.bas:118
msgid "%1 call relations"
msgstr "%1 aanroeprelaties"

#: inc/out_graph.bas:122
msgid "diagram: %1 relations"
msgstr "diagram: %1 relaties"

#: inc/out_graph.bas:124
msgid "that is a lot for a readable diagram. Consider --ref-depth 0,"
msgstr "dat is veel voor een leesbaar diagram. Overweeg --ref-depth 0,"

#: inc/out_graph.bas:125
msgid "a smaller path, or render with sfdp instead of dot."
msgstr "een kleiner pad, of render met sfdp in plaats van dot."

