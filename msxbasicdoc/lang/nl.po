#: msxbasicdoc.bas:25
msgid "msxbasicdoc %1 - documentation for MSX-BASIC programs"
msgstr "msxbasicdoc %1 - documentatie voor MSX-BASIC programma's"

#: msxbasicdoc.bas:27
msgid "Usage: msxbasicdoc [options] PROGRAM.BAS [...]"
msgstr "Gebruik: msxbasicdoc [opties] PROGRAMMA.BAS [...]"

#: msxbasicdoc.bas:29
msgid "Options:"
msgstr "Opties:"

#: msxbasicdoc.bas:30
msgid "  -o DIR     output in DIR (default: next to the source file)"
msgstr "  -o MAP     uitvoer in MAP (standaard: naast het bronbestand)"

#: msxbasicdoc.bas:31
msgid "  -dot       also write a Graphviz .dot file of the call graph"
msgstr "  -dot       ook een Graphviz .dot-bestand van de aanroepgraaf maken"

#: msxbasicdoc.bas:32
msgid "  -l CODE    language: en (default), lang/CODE.po next to the"
msgstr "  -l CODE    taal: en (standaard), lang/CODE.po naast het"

#: msxbasicdoc.bas:33
msgid "             program, or a .po file; MSXBASICDOC_LANG sets the default"
msgstr "             programma, of een .po-bestand; MSXBASICDOC_LANG zet de standaard"

#: msxbasicdoc.bas:34
msgid "  -q         quiet: show errors only"
msgstr "  -q         stil: alleen fouten tonen"

#: msxbasicdoc.bas:35
msgid "  -h         this help"
msgstr "  -h         deze hulp"

#: msxbasicdoc.bas:37
msgid "Input must be ASCII (on the MSX: %1)."
msgstr "Invoer moet ASCII zijn (op de MSX: %1)."

#. Example file name in the help text.
#: msxbasicdoc.bas:37
msgid "NAME.BAS"
msgstr "NAAM.BAS"

#: msxbasicdoc.bas:39
msgid "Documentation conventions in comments:"
msgstr "Documentatieconventies in commentaar:"

#: msxbasicdoc.bas:40
msgid "  '## Name - description    name of a routine (or of the program, at the top)"
msgstr "  '## Naam - omschrijving   naam van routine (of programma, bovenaan)"

#: msxbasicdoc.bas:41
msgid "  '@tag value               free tags, e.g. '@in X,Y  '@out A$"
msgstr "  '@tag waarde              vrije tags, bijv. '@in X,Y  '@uit A$"

#: msxbasicdoc.bas:42
msgid "  ' plain text              description"
msgstr "  ' gewone tekst            omschrijving"

